<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>VPN Split Tunnel</vendor>
  <vendor_url>https://github.com/sina/vpn-split-tunnel</vendor_url>
  <icon_name>com.github.sina.vpn-split-tunnel</icon_name>

  <action id="com.github.sina.vpn-split-tunnel.apply-policy">
    <description>Apply VPN split tunneling policy</description>
    <message>Authentication is required to apply VPN split tunneling rules</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/vpn-split-tunnel-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">apply</annotate>
  </action>

  <action id="com.github.sina.vpn-split-tunnel.remove-policy">
    <description>Remove VPN split tunneling policy</description>
    <message>Authentication is required to remove VPN split tunneling rules</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/vpn-split-tunnel-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">remove</annotate>
  </action>

</policyconfig>